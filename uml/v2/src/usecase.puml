' layout only: $nb(n) returns n non-breaking spaces, used to move a label
' beside its vertical arrow instead of across it
!function $nb($n)
  !$s = ""
  !$i = 0
  !while $i < $n
    !$s = $s + %chr(160)
    !$i = $i + 1
  !endwhile
  !return $s
!endfunction

