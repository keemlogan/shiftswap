@startuml state-payroll
!pragma layout smetana
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #1C2230
  FontColor #1C2230
  ArrowColor #1C2230
}

title Payroll.status state machine (spec §7)

[*] --> DRAFT : generatePayroll(yearMonth) (UC-09, FR-15, BR-11)

state DRAFT {
  DRAFT : every row with minWageWarning must have\nminWageAck = 1 before Confirm is enabled (FR-16, BR-09)
  DRAFT : internal: acknowledge minimum-wage warning\n[row has minWageWarning] / acknowledgeMinWage(yearMonth, workerId)\n-> minWageAck := 1 (BR-09)
  DRAFT --> DRAFT : re-generate month\n[replaces DRAFT rows only, CONFIRMED rows kept] / generatePayroll(yearMonth) (UC-09)
}

DRAFT --> CONFIRMED : owner confirms\n[all minWageWarning rows have minWageAck = 1] / confirmPayroll(yearMonth) (UC-09, FR-15)

CONFIRMED --> [*]

note right of CONFIRMED : final state — read-only,\nnot replaced by re-generation
@enduml
