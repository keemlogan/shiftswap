@startuml seq-3-approve
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1
skinparam sequenceParticipant underline
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #1C2230
}
skinparam sequence {
  LifeLineBorderColor #1C2230
  ArrowColor #1C2230
  BoxBorderColor #1C2230
}

title UC-06 Approve or reject substitution (FR-11, FR-12, BR-04; includes UC-08)

actor "A2 Owner" as Owner
boundary "approvals.js" as UI
control "SubstituteService" as Svc
control "AttendanceService" as Attend
control "LaborRules" as Rules
database "db.js\n(SQLite / localStorage)" as DB

Owner -> UI : open ACCEPTED request
UI -> Svc : loadComparison(requestId)
activate Svc
Svc -> DB : get SubRequest, Shift, requester, acceptor
DB --> Svc : entities
Svc -> Rules : computeWeeklySummary(requester, weekStart) "before"
Rules --> Svc : before(requester)
Svc -> Rules : computeWeeklySummary(acceptor, weekStart) "before"
Rules --> Svc : before(acceptor)
Svc --> UI : before-tables for requester & acceptor
deactivate Svc
UI --> Owner : show contract/scheduled hours & holiday eligibility "before"

Owner -> UI : Approve
UI -> Svc : decideRequest(requestId, APPROVED)
activate Svc
Svc -> DB : tx(fn) begin
activate DB
Svc -> DB : get SubRequest (must be ACCEPTED, BR-04)

alt request not ACCEPTED
  Svc -> DB : rollback
  Svc --> UI : error "cannot approve"
else request is ACCEPTED
  Svc -> DB : update Shift.workerId = acceptor,\nShift.originalWorkerId = requester (if null)
  Svc -> DB : update SubRequest.status = APPROVED, decidedAt = now

  Svc -> Attend : recomputeWeek(requesterId, weekStart)
  activate Attend
  Attend -> Rules : computeWeeklySummary(requester, weekStart) "after"
  Rules --> Attend : after(requester)
  Attend -> DB : upsert WeeklySummary(requester, weekStart)
  deactivate Attend

  Svc -> Attend : recomputeWeek(acceptorId, weekStart)
  activate Attend
  Attend -> Rules : computeWeeklySummary(acceptor, weekStart) "after"
  Rules --> Attend : after(acceptor)
  Attend -> DB : upsert WeeklySummary(acceptor, weekStart)
  deactivate Attend

  Svc -> DB : insert Notification(REQUEST_APPROVED) to requester, acceptor
  Svc -> DB : commit + persist
  deactivate DB
  Svc --> UI : approved, after(requester), after(acceptor)
  UI --> Owner : show before/after comparison,\nhighlight eligibility change (FR-11)
end
deactivate Svc

alt Owner rejects instead
  Owner -> UI : Reject
  UI -> Svc : decideRequest(requestId, REJECTED)
  Svc -> DB : tx: update SubRequest.status = REJECTED\n(Shift unchanged, BR-04)
  Svc -> DB : insert Notification(REQUEST_REJECTED) to requester, acceptor
  Svc --> UI : rejected
  UI --> Owner : shift unchanged
end
@enduml
