@startuml seq-4-payroll
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1
skinparam sequenceParticipant underline
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #1C2230
}
skinparam sequence {
  LifeLineBorderColor #1C2230
  ArrowColor #1C2230
  BoxBorderColor #1C2230
}

title UC-09 Generate and confirm monthly payroll (FR-15, FR-16, BR-08, BR-09, BR-10, BR-11; includes UC-08)

actor "A2 Owner" as Owner
boundary "payroll.js" as UI
control "PayrollService" as Svc
control "LaborRules" as Rules
database "db.js" as DB

Owner -> UI : pick month, "Generate draft"
UI -> Svc : generatePayroll(yearMonth)
activate Svc
Svc -> DB : tx(fn) begin
activate DB
Svc -> DB : get Workplace, all MinimumWage rows
DB --> Svc : workplace, minimumWages

Svc -> Rules : minimumWageFor(year, minimumWages)
Rules --> Svc : minimumHourly

Svc -> Svc : recomputeWeek(monday) for each week\nwhose Sunday falls in the month (BR-11)
Svc -> DB : delete DRAFT Payroll rows of yearMonth

loop for each Worker W (skip if a CONFIRMED row exists)
  Svc -> DB : get W's shifts of the month (WORKED actual\ntimes, else SCHEDULED "estimated"),\nholidayWeeks = WeeklySummary.holidayHours
  Svc -> Rules : probationApplies(W, payrollDate) (BR-10)
  Rules --> Svc : probation
  Svc -> Rules : computePayrollRow({hourlyWage, shifts,\nholidayWeeks, regularEmployees,\nminimumHourly, probation})
  activate Rules
  Rules -> Rules : premiumHours(shifts, regularEmployees)\n(BR-08: only if regularEmployees >= 5)
  Rules --> Svc : {baseHours, basePay, holidayPay,\npremiumPay, total, minWageWarning, estimated}
  deactivate Rules
  Svc -> DB : insert Payroll row (status='DRAFT')
end

Svc -> DB : commit + persist
deactivate DB
Svc --> UI : Payroll[] (DRAFT) with minimumHourly, probation per row
deactivate Svc
UI --> Owner : table per worker + minimum-wage warning rows (BR-09)

alt row has minWageWarning and not yet acknowledged
  Owner -> UI : Acknowledge (yearMonth, workerId)
  UI -> Svc : acknowledgeMinWage(yearMonth, workerId)
  activate Svc
  Svc -> DB : tx: get DRAFT row; error NO_DRAFT / NO_WARNING\nif missing or not warned
  Svc -> DB : UPDATE Payroll SET minWageAck = 1
  Svc --> UI : {workerId, minWageAck: 1}
  deactivate Svc
end

Owner -> UI : Confirm
UI -> Svc : confirmPayroll(yearMonth)
activate Svc
Svc -> DB : tx: get DRAFT rows of yearMonth

alt any DRAFT row has minWageWarning && !minWageAck
  Svc --> UI : throw ServiceError('MIN_WAGE_UNACKNOWLEDGED',\nlisting the unacknowledged workers' names)
  UI --> Owner : block confirm, list workers to acknowledge
else all warnings acknowledged
  Svc -> DB : UPDATE Payroll SET status='CONFIRMED'\nWHERE yearMonth=? AND status='DRAFT'
  Svc --> UI : {confirmed: count}
  UI --> Owner : payroll rows become read-only
end
deactivate Svc
@enduml
