@startuml class
!pragma layout smetana
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam classFontColor #1C2230
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1C2230
  ArrowColor #1C2230
}
skinparam class<<service>> {
  BackgroundColor #FFFFFF
  BorderColor #E9A23B
}
skinparam class<<query>> {
  BackgroundColor #FFFFFF
  BorderColor #6B8CAE
}
hide circle
hide empty members

' ===== enumerations =====
enum Role {
  OWNER
  WORKER
}
enum SubAttendancePolicy {
  EXCUSED
  ABSENT
}
enum ShiftStatus {
  SCHEDULED
  WORKED
  ABSENT
}
enum SubRequestStatus {
  REQUESTED
  ACCEPTED
  APPROVED
  REJECTED
  FAILED
  EXPIRED
  CANCELLED
}
enum TargetResponse {
  PENDING
  ACCEPTED
  DECLINED
  CLOSED
}
enum PayrollStatus {
  DRAFT
  CONFIRMED
}
enum NotificationKind {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_EXPIRED
  REQUEST_CANCELLED
  REQUEST_FAILED
  TARGET_CLOSED
}

' ===== domain entities (spec §8) =====
class Workplace {
  id : int <<PK>>
  name : string
  regularEmployees : int
  subAttendancePolicy : SubAttendancePolicy
}

class Worker {
  id : int <<PK>>
  workplaceId : int <<FK>>
  role : Role
  name : string
  phone : string
  hourlyWage : int
  contractStart : date
  contractEnd : date
  probationEnd : date
  simpleLabor : boolean
  active : boolean
}

class FixedSchedule {
  id : int <<PK>>
  workerId : int <<FK>>
  weekday : int
  startTime : time
  endTime : time
}

class Shift {
  id : int <<PK>>
  workDate : date
  startTime : time
  endTime : time
  workerId : int <<FK>>
  originalWorkerId : int <<FK>>
  fixedScheduleId : int <<FK>>
  status : ShiftStatus
}

class SubRequest {
  id : int <<PK>>
  shiftId : int <<FK>>
  requesterId : int <<FK>>
  acceptorId : int <<FK>>
  reason : string
  deadline : datetime
  status : SubRequestStatus
  createdAt : datetime
  decidedAt : datetime
}

class SubRequestTarget {
  id : int <<PK>>
  subRequestId : int <<FK>>
  workerId : int <<FK>>
  response : TargetResponse
  respondedAt : datetime
}

class Attendance {
  id : int <<PK>>
  shiftId : int <<FK>>
  clockIn : datetime
  clockOut : datetime
  confirmed : boolean
}

class WeeklySummary {
  id : int <<PK>>
  workerId : int <<FK>>
  weekStart : date
  contractHours : float
  scheduledHours : float
  actualHours : float
  perfectAttendance : boolean
  holidayEligible : boolean
  holidayHours : float
}

class Payroll {
  id : int <<PK>>
  workerId : int <<FK>>
  yearMonth : string
  baseHours : float
  basePay : int
  holidayPay : int
  premiumPay : int
  total : int
  minWageWarning : boolean
  minWageAck : boolean
  estimated : boolean
  status : PayrollStatus
}

class MinimumWage {
  year : int <<PK>>
  hourly : int
}

class Notification {
  id : int <<PK>>
  workerId : int <<FK>>
  subRequestId : int <<FK>>
  kind : NotificationKind
  message : string
  createdAt : datetime
  readAt : datetime
}

' ===== services (app/core/services.js) — real exported signatures =====
class ScheduleService <<service>> {
  +registerWorker(data) : int
  +saveFixedSchedule(workerId, slots) : FixedSchedule[]
  +generateWeek(weekStart) : {weekStart, created}
  +editShift(shiftId, changes) : int
  +updateSettings({name, regularEmployees,\n  subAttendancePolicy, minimumWages}) : {workplace, minimumWages}
}

class SubstituteService <<service>> {
  +defaultDeadline(shift) : string
  +createSubRequest({shiftId, requesterId,\n  reason, deadline}) : {id, status, candidates}
  +respondToRequest(requestId, workerId, response) : {status}
  +decideRequest(requestId, decision) : {status}
  +cancelRequest(requestId, requesterId) : {status}
  +expireOverdue() : int
  +getApprovalPreview(requestId) : {request, weekStart, rows}
}

class AttendanceService <<service>> {
  +recordAttendance(shiftId, workerId,\n  clockIn, clockOut) : {shiftId, hours}
  +confirmAttendance(shiftId) : {status}
  +markAbsent(shiftId) : {status}
  +recomputeWeek(weekStart, workerIds) : WeeklySummary[]
}

class PayrollService <<service>> {
  +generatePayroll(yearMonth) : Payroll[]
  +acknowledgeMinWage(yearMonth, workerId) : {workerId, minWageAck}
  +confirmPayroll(yearMonth) : {confirmed}
}

class NotificationService <<service>> {
  +listNotifications(workerId) : {items, unread}
  +markNotificationsRead(workerId, ids?) : int
}

class LaborRules <<service>> {
  +{static} overlaps(aStart, aEnd, bStart, bEnd) : boolean
  +{static} durationHours(start, end) : float
  +{static} weekStartOf(date) : date
  +{static} isEligibleCandidate({worker, requesterId,\n  shift, workerShifts}) : boolean
  +{static} hasNoTaker(responses) : boolean
  +{static} validateRequest({shift, requesterId,\n  now, deadline, openRequests}) : string[]
  +{static} contractHours(fixedSchedules) : float
  +{static} computeWeeklySummary({workerId,\n  contractHours, shifts, policy}) : WeeklySummary
  +{static} holidayHours(contractHours) : float
  +{static} premiumHours(shifts, regularEmployees) : {daily, weekly, night, total}
  +{static} minimumWageFor(year, rows) : int
  +{static} probationApplies(worker, date) : boolean
  +{static} computePayrollRow({hourlyWage, shifts,\n  holidayWeeks, regularEmployees,\n  minimumHourly, probation}) : Payroll
  +{static} round2(x) : float
}

class HomeQueries <<query>> {
  +getWorkerHome(workerId) : {worker, today, incoming, taken,\n  myOpen, failed, nextShift, week, toRecord}
  +getOwnerHome() : {today, decisions, open, failed,\n  toConfirm, payWarnings, taskCount, todayShifts, week}
  +previewCandidates(shiftId, requesterId) : {id, name}[]
  +getShiftDetail(shiftId) : {...Shift, history, canDelete}
}
note bottom of HomeQueries : read-only queries for the\ntask-first Home screens (NFR-13)

' ===== relationships =====
Workplace "1" -- "*" Worker
Worker "1" -- "*" FixedSchedule
Worker "1" -- "*" Shift : currently assigned >
Worker "0..1" -- "*" Shift : originally owned >
FixedSchedule "0..1" -- "*" Shift : generated from >
Shift "1" -- "*" SubRequest
Worker "1" -- "*" SubRequest : requests >
Worker "0..1" -- "*" SubRequest : accepts >
SubRequest "1" -- "*" SubRequestTarget
Worker "1" -- "*" SubRequestTarget
Shift "1" -- "0..1" Attendance
Worker "1" -- "*" WeeklySummary
Worker "1" -- "*" Payroll
Worker "1" -- "*" Notification
SubRequest "0..1" -- "*" Notification

Worker::role .. Role
Workplace::subAttendancePolicy .. SubAttendancePolicy
Shift::status .. ShiftStatus
SubRequest::status .. SubRequestStatus
SubRequestTarget::response .. TargetResponse
Payroll::status .. PayrollStatus
Notification::kind .. NotificationKind

ScheduleService ..> Worker
ScheduleService ..> FixedSchedule
ScheduleService ..> Shift
ScheduleService ..> Workplace
ScheduleService ..> LaborRules : overlaps(), addDays()
SubstituteService ..> SubRequest
SubstituteService ..> SubRequestTarget
SubstituteService ..> LaborRules
AttendanceService ..> Attendance
AttendanceService ..> Shift
AttendanceService ..> WeeklySummary
AttendanceService ..> LaborRules
PayrollService ..> Payroll
PayrollService ..> MinimumWage
PayrollService ..> LaborRules
NotificationService ..> Notification
HomeQueries ..> Worker
HomeQueries ..> Workplace
HomeQueries ..> Shift
HomeQueries ..> SubRequest
HomeQueries ..> SubRequestTarget
HomeQueries ..> Attendance
HomeQueries ..> Payroll
HomeQueries ..> Notification
HomeQueries ..> FixedSchedule
HomeQueries ..> LaborRules : isEligibleCandidate(),\ncomputeWeeklySummary() (swap effect)
@enduml
