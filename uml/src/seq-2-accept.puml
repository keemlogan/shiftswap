@startuml seq-2-accept
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1
skinparam sequenceParticipant underline
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #1C2230
}
skinparam sequence {
  LifeLineBorderColor #1C2230
  ArrowColor #1C2230
  BoxBorderColor #1C2230
}

title UC-05 Respond to substitute request - accept / can't (FR-09, FR-22, BR-02, BR-13, NFR-04, NFR-14)\nShared mode: two candidates answer at the same time

actor "A1 Worker\n(candidate 1)" as W1
actor "A1 Worker\n(candidate 2)" as W2
box "Browser of the answering candidate (own working copy)" #FFFFFF
  boundary "requests.js" as UI
  control "shared.js\n(gateway)" as GW
  control "SubstituteService" as Svc
  database "db.js\n(sql.js working copy)" as DB
end box
database "Supabase PostgreSQL\n(app_commit, row triggers)" as Srv

note over W1, W2 : both candidates see the same PENDING\nSubRequestTarget in their inbox (BR-01)

note over Svc, Srv
  both working copies were loaded by app_snapshot at revision r;
  the conditional UPDATE guards only its own working copy.
  Across browsers the server decides: app_commit locks the
  store row and accepts a change set only if its base
  revision is still the current one (NFR-04, NFR-14).
end note

par candidate 1 accepts (browser 1)
  W1 -> UI : Accept (requestId=R, workerId=W1)
  UI -> GW : ctx.run(command)
  activate GW
  GW -> Svc : respondToRequest(R, W1, 'ACCEPTED')
  activate Svc
  Svc -> DB : tx(fn): get SubRequest+Shift,\nget SubRequestTarget(R, W1)
  activate DB
  DB --> Svc : r.status = 'REQUESTED',\ntarget.response = 'PENDING'
  Svc -> DB : UPDATE SubRequest SET status='ACCEPTED',\nacceptorId=W1 WHERE id=R AND status='REQUESTED'
  DB --> Svc : changes = 1
  Svc -> DB : UPDATE target(W1) = 'ACCEPTED',\nother PENDING targets -> 'CLOSED'
  Svc -> DB : insert Notification(REQUEST_ACCEPTED,\nTARGET_CLOSED)
  Svc -> DB : commit (working copy only)
  deactivate DB
  Svc --> GW : {status: 'ACCEPTED'}
  deactivate Svc
  GW -> GW : change set = rows changed\nsince the last sync
  GW -> Srv : RPC app_commit(store, base_rev = r, changes)
  activate Srv
  Srv -> Srv : lock store row (FOR UPDATE);\nbase_rev = r = current revision
  Srv -> Srv : apply rows; row triggers check\nREQUESTED -> ACCEPTED only, deadline and\nshift start against server time
  Srv --> GW : {rev: r + 1, now}
  deactivate Srv
  GW --> UI : {status: 'ACCEPTED'}
  deactivate GW
  UI --> W1 : "You accepted the shift"
else candidate 2 accepts at the same time (browser 2, revision r)
  W2 -> UI : Accept (requestId=R, workerId=W2)
  UI -> GW : ctx.run(command)
  activate GW
  GW -> Svc : respondToRequest(R, W2, 'ACCEPTED')
  activate Svc
  Svc -> DB : same steps on this working copy:\nstatus 'REQUESTED', UPDATE changes = 1
  Svc --> GW : {status: 'ACCEPTED'}
  deactivate Svc
  GW -> Srv : RPC app_commit(store, base_rev = r, changes)
  activate Srv
  Srv -> Srv : lock store row (FOR UPDATE);\ncurrent revision is r + 1, not r
  Srv --> GW : error STALE (nothing applied)
  deactivate Srv
  GW -> Srv : RPC app_snapshot(store)
  Srv --> GW : {rev: r + 1, now, tables}
  GW -> DB : loadTables(tables):\nreplace the working copy,\nuse server time
  GW -> Svc : run the command again\n(at most 3 times)
  activate Svc
  Svc -> DB : get SubRequest,\nget SubRequestTarget(R, W2)
  DB --> Svc : r.status = 'ACCEPTED' by candidate 1 (Choi Minho),\ntarget.response = 'CLOSED'
  Svc --> GW : throw ServiceError('ALREADY_TAKEN',\n"Already taken by Choi Minho.")
  deactivate Svc
  GW --> UI : ALREADY_TAKEN\n(no change to save)
  deactivate GW
  UI --> W2 : show "Choi Minho was faster.\nNothing to do."
end

== Later: last remaining candidate answers can't (BR-13, FR-22) ==

W1 -> UI : Can't (requestId=R2, workerId=W1)
UI -> GW : ctx.run(command)
activate GW
GW -> Svc : respondToRequest(R2, W1, 'DECLINED')
activate Svc
Svc -> DB : tx(fn): get SubRequest+Shift,\nget SubRequestTarget(R2, W1)
activate DB
DB --> Svc : r.status = 'REQUESTED',\ntarget.response = 'PENDING'
Svc -> DB : UPDATE target(W1).response = 'DECLINED',\nrespondedAt = now
Svc -> DB : SELECT response FROM SubRequestTarget\nWHERE subRequestId=R2
DB --> Svc : all other targets already DECLINED

alt every target now DECLINED (BR-13)
  Svc -> DB : UPDATE SubRequest SET status='FAILED'\nWHERE id=R2 AND status='REQUESTED' (failRequest)
  Svc -> DB : insert Notification(REQUEST_FAILED) to requester\n("no co-worker can take it - contact the owner")
  Svc -> DB : insert Notification(REQUEST_FAILED) to owner\n(acknowledge only)
end
Svc -> DB : commit (working copy only)
deactivate DB
Svc --> GW : {status: 'FAILED'} or {status: 'REQUESTED'}
deactivate Svc
GW -> Srv : RPC app_commit(store, base_rev, changes)
activate Srv
Srv --> GW : {rev + 1, now}\n(if FAILED: a trigger allows REQUESTED -> FAILED)
deactivate Srv
GW --> UI : {status}
deactivate GW
UI --> W1 : "You can't take this shift"\n(FAILED: the request is closed - no one could take it)

note over Svc, DB
  a single can't (DECLINED) notifies no one; only the
  decline that makes every target DECLINED triggers
  REQUEST_FAILED (BR-13). Accepting a FAILED request
  afterwards is refused as ServiceError('REQUEST_CLOSED').
end note
@enduml
